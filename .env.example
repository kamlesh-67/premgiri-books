# ─── NEXTAUTH ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET="your-32-char-random-hex-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-32-char-random-hex-string"

# ─── PHASE 8: e-Invoice (IRP) API ────────────────────────────────────────────
# NEVER commit real credentials — keys below must remain empty in version control
IRP_MOCK_MODE=true                    # Set to false when real IRP creds are available
IRP_BASE_URL=https://einv-apisandbox.nic.in
IRP_CLIENT_ID=                        # From NIC sandbox registration
IRP_CLIENT_SECRET=                    # From NIC sandbox registration
IRP_USERNAME=                         # GSTIN-specific username from IRP portal
IRP_PASSWORD=                         # GSTIN-specific password
IRP_PUBLIC_KEY=                       # NIC RSA public key (PEM format, multiline → base64 encode for env)

# Phase 11: AI Foundation (deferred — Phase 17 SQLite mode disables vector embedding)
VOYAGE_API_KEY=             # https://dash.voyageai.com -> API Keys (Voyage AI voyage-3-lite, 1024-dim, per D-01)
ANTHROPIC_API_KEY=          # https://console.anthropic.com (Claude Haiku 4.5, per D-02 — model id claude-haiku-4-5-20251001)
