# ─── DATABASE ────────────────────────────────────────────────────────────────
# Local: postgresql://postgres:postgres123@localhost:5432/premgiri_books
# Prod (Neon): postgresql://user:password@host/premgiri_books?sslmode=require
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/premgiri_books"
DIRECT_URL="postgresql://postgres:postgres123@localhost:5432/premgiri_books"

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Prod (Upstash): rediss://default:token@host.upstash.io:6380
REDIS_URL="redis://localhost:6379"

# ─── FILE STORAGE (MinIO local / Cloudflare R2 in prod) ──────────────────────
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET_NAME="premgiri-dev"
R2_PUBLIC_URL="http://localhost:9000/premgiri-dev"

# ─── EMAIL (Mailhog local / Resend in prod) ───────────────────────────────────
# Set EMAIL_PROVIDER=nodemailer for local dev (Mailhog)
# Set EMAIL_PROVIDER=resend for staging/prod (Resend API key required)
EMAIL_PROVIDER="nodemailer"
SMTP_HOST="localhost"
SMTP_PORT="1025"
RESEND_API_KEY="re_your_resend_api_key_here"

# ─── INNGEST ─────────────────────────────────────────────────────────────────
# Local: use value "local" for both keys (Inngest dev server)
# Prod: get from Inngest Cloud dashboard
INNGEST_EVENT_KEY="your_inngest_event_key"
INNGEST_SIGNING_KEY="your_inngest_signing_key"
INNGEST_DEV_SERVER_URL="http://localhost:8288"

# ─── POSTHOG (PostHog Cloud — same project key for dev and prod) ──────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_api_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── NEXTAUTH ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET="your-32-char-random-hex-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-32-char-random-hex-string"

# ─── NEON (staging/prod only) ────────────────────────────────────────────────
# NEON_DATABASE_URL=postgresql://...neon.tech/premgiri_books
# USE_NEON_ADAPTER=true

# ─── UPSTASH (staging/prod only) ─────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# ─── PHASE 8: e-Invoice (IRP) API ────────────────────────────────────────────
# NEVER commit real credentials — keys below must remain empty in version control
IRP_MOCK_MODE=true                    # Set to false when real IRP creds are available
IRP_BASE_URL=https://einv-apisandbox.nic.in
IRP_CLIENT_ID=                        # From NIC sandbox registration
IRP_CLIENT_SECRET=                    # From NIC sandbox registration
IRP_USERNAME=                         # GSTIN-specific username from IRP portal
IRP_PASSWORD=                         # GSTIN-specific password
IRP_PUBLIC_KEY=                       # NIC RSA public key (PEM format, multiline → base64 encode for env)

# Phase 11: AI Foundation
VOYAGE_API_KEY=             # https://dash.voyageai.com -> API Keys (Voyage AI voyage-3-lite, 1024-dim, per D-01)
ANTHROPIC_API_KEY=          # https://console.anthropic.com (Claude Haiku 4.5, per D-02 — model id claude-haiku-4-5-20251001)
