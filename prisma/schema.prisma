generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id                String             @id @default(cuid())
  name              String
  gstin             String?
  pan               String?
  stateCode         String
  address           String?
  fyStart           Int                @default(4)
  logoUrl           String?
  annualTurnover    Decimal?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accountGroups     AccountGroup[]
  attendanceRecords AttendanceRecord[]
  auditLogs         AuditLog[]
  bankStatements    BankStatement[]
  bankTransactions  BankTransaction[]
  billRefs          BillRef[]
  costCentres       CostCentre[]
  eInvoiceLogs      EInvoiceLog[]
  employees         Employee[]
  godowns           Godown[]
  gstReturns        GstReturn[]
  gstTransactions   GstTransaction[]
  gstr2aImports     Gstr2aImport[]
  ledgers           Ledger[]
  notifications     Notification[]
  orderSequences    OrderSequence[]
  orders            Order[]
  payRuns           PayRun[]
  paySlips          PaySlip[]
  roles             Role[]
  salaryStructures  SalaryStructure[]
  stockBatches      StockBatch[]
  stockConsumptions StockConsumption[]
  stockGroups       StockGroup[]
  stockItems        StockItem[]
  unitsOfMeasure    UnitOfMeasure[]
  users             User[]
  voucherSequences  VoucherSequence[]
  vouchers          Voucher[]

  @@map("companies")
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  name         String
  email        String
  passwordHash String
  roleId       String?
  uiMode       String     @default("simple")
  isActive     Boolean    @default(true)
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  role         Role?      @relation(fields: [roleId], references: [id])
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  permissions Json
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([companyId, name])
  @@map("roles")
}

model AccountGroup {
  id        String         @id @default(cuid())
  companyId String
  name      String
  parentId  String?
  nature    AccountNature
  affectsGP Boolean        @default(false)
  isSystem  Boolean        @default(false)
  createdAt DateTime       @default(now())
  parent    AccountGroup?  @relation("AccountGroupHierarchy", fields: [parentId], references: [id])
  children  AccountGroup[] @relation("AccountGroupHierarchy")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgers   Ledger[]

  @@unique([companyId, name])
  @@map("account_groups")
}

model Ledger {
  id             String          @id @default(cuid())
  companyId      String
  name           String
  groupId        String
  gstin          String?
  pan            String?
  address        String?
  openingBalance Decimal         @default(0)
  drCr           DrCr            @default(DR)
  gstRegType     GstRegType      @default(UNREGISTERED)
  creditLimit    Decimal?
  creditDays     Int?
  bankName       String?
  bankAccount    String?
  ifsc           String?
  stateCode      String?
  isActive       Boolean         @default(true)
  tdsApplicable  Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bankStatements BankStatement[]
  billRefs       BillRef[]
  employees      Employee[]      @relation("SalaryLedger")
  group          AccountGroup    @relation(fields: [groupId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders         Order[]         @relation("OrderParty")
  voucherEntries VoucherEntry[]
  vouchers       Voucher[]       @relation("PartyLedger")

  @@unique([companyId, name])
  @@map("ledgers")
}

model StockGroup {
  id         String       @id @default(cuid())
  companyId  String
  name       String
  parentId   String?
  parent     StockGroup?  @relation("StockGroupHierarchy", fields: [parentId], references: [id])
  children   StockGroup[] @relation("StockGroupHierarchy")
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockItems StockItem[]

  @@unique([companyId, name])
  @@map("stock_groups")
}

model StockItem {
  id            String        @id @default(cuid())
  companyId     String
  name          String
  groupId       String
  uomId         String
  hsnCode       String
  gstRate       Decimal
  gstApplicable Boolean       @default(true)
  openingQty    Decimal       @default(0)
  openingRate   Decimal       @default(0)
  reorderQty    Decimal?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  stockBatches  StockBatch[]
  uom           UnitOfMeasure @relation(fields: [uomId], references: [id])
  group         StockGroup    @relation(fields: [groupId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherItems  VoucherItem[]

  @@unique([companyId, name])
  @@map("stock_items")
}

model UnitOfMeasure {
  id         String      @id @default(cuid())
  companyId  String
  name       String
  symbol     String
  stockItems StockItem[]
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, symbol])
  @@map("units_of_measure")
}

model Godown {
  id           String        @id @default(cuid())
  companyId    String
  name         String
  address      String?
  isMain       Boolean       @default(false)
  isActive     Boolean       @default(true)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  stockBatches StockBatch[]
  voucherItems VoucherItem[]

  @@unique([companyId, name])
  @@map("godowns")
}

model VoucherSequence {
  id            String      @id @default(cuid())
  companyId     String
  voucherType   VoucherType
  financialYear String
  lastSequence  Int         @default(0)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, voucherType, financialYear])
  @@map("voucher_sequences")
}

model OrderSequence {
  id            String    @id @default(cuid())
  companyId     String
  orderType     OrderType
  financialYear String
  lastSequence  Int       @default(0)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, orderType, financialYear])
  @@map("order_sequences")
}

model Voucher {
  id                  String             @id @default(cuid())
  companyId           String
  voucherType         VoucherType
  voucherNo           String
  date                DateTime
  narration           String?
  partyLedgerId       String?
  totalAmount         Decimal
  cgstAmount          Decimal            @default(0)
  sgstAmount          Decimal            @default(0)
  igstAmount          Decimal            @default(0)
  roundOff            Decimal            @default(0)
  status              VoucherStatus      @default(DRAFT)
  irn                 String?
  eWayBillNo          String?
  irnQrCode           String?
  irnGeneratedAt      DateTime?
  eWayBillValidUntil  DateTime?
  chequeNo            String?
  chequeDated         DateTime?
  bankName            String?
  chequeStatus        String?            @default("ISSUED")
  clearanceDate       DateTime?
  tdsSection          String?
  tdsRate             Decimal?
  tdsAmount           Decimal?
  linkedVoucherId     String?
  dueDate             DateTime?
  paymentTerms        String?
  placeOfSupply       String?
  reverseCharge       Boolean            @default(false)
  billingAddress      String?
  shippingAddress     String?
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  createdBy           String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  bankTransactions    BankTransaction[]
  billRefs            BillRef[]
  eInvoiceLogs        EInvoiceLog[]
  gstTransactions     GstTransaction[]
  stockConsumptions   StockConsumption[]
  voucherEntries      VoucherEntry[]
  voucherItems        VoucherItem[]
  partyLedger         Ledger?            @relation("PartyLedger", fields: [partyLedgerId], references: [id])
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, voucherType, voucherNo])
  @@index([companyId, date])
  @@index([companyId, status])
  @@map("vouchers")
}

model VoucherEntry {
  id           String      @id @default(cuid())
  voucherId    String
  ledgerId     String
  amount       Decimal
  drCr         DrCr
  narration    String?
  billRef      String?
  costCentreId String?
  ledger       Ledger      @relation(fields: [ledgerId], references: [id])
  voucher      Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id])

  @@index([voucherId])
  @@map("voucher_entries")
}

model VoucherItem {
  id          String      @id @default(cuid())
  voucherId   String
  itemId      String
  godownId    String?
  qty         Decimal
  rate        Decimal
  amount      Decimal
  discountPct Decimal?
  discountAmt Decimal?
  cgstRate    Decimal?
  cgstAmt     Decimal?
  sgstRate    Decimal?
  sgstAmt     Decimal?
  igstRate    Decimal?
  igstAmt     Decimal?
  hsnCode     String?
  unit        String?
  batchNo     String?
  itcEligible Boolean     @default(true)
  createdAt   DateTime    @default(now())
  stockBatch  StockBatch?
  godown      Godown?     @relation(fields: [godownId], references: [id])
  item        StockItem   @relation(fields: [itemId], references: [id])
  voucher     Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@map("voucher_items")
}

model StockBatch {
  id                String             @id @default(cuid())
  companyId         String
  itemId            String
  godownId          String?
  voucherItemId     String?            @unique
  purchaseDate      DateTime
  qty               Decimal
  remainingQty      Decimal
  costRate          Decimal
  batchNo           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  voucherItem       VoucherItem?       @relation(fields: [voucherItemId], references: [id])
  godown            Godown?            @relation(fields: [godownId], references: [id])
  item              StockItem          @relation(fields: [itemId], references: [id])
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockConsumptions StockConsumption[]

  @@index([companyId, itemId, godownId, purchaseDate])
  @@index([companyId, isActive])
  @@map("stock_batches")
}

model StockConsumption {
  id           String     @id @default(cuid())
  companyId    String
  stockBatchId String
  voucherId    String
  qty          Decimal
  createdAt    DateTime   @default(now())
  voucher      Voucher    @relation(fields: [voucherId], references: [id])
  stockBatch   StockBatch @relation(fields: [stockBatchId], references: [id])
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId])
  @@index([stockBatchId])
  @@map("stock_consumptions")
}

model GstTransaction {
  id             String     @id @default(cuid())
  companyId      String
  voucherId      String
  gstinSupplier  String?
  gstinRecipient String?
  supplyType     SupplyType
  returnPeriod   String
  taxableValue   Decimal
  cgst           Decimal    @default(0)
  sgst           Decimal    @default(0)
  igst           Decimal    @default(0)
  placeOfSupply  String
  reverseCharge  Boolean    @default(false)
  gstr1Status    GstrStatus @default(PENDING)
  gstr3bStatus   GstrStatus @default(PENDING)
  createdAt      DateTime   @default(now())
  voucher        Voucher    @relation(fields: [voucherId], references: [id])
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("gst_transactions")
}

model GstReturn {
  id           String          @id @default(cuid())
  companyId    String
  returnType   String
  returnPeriod String
  status       GstReturnStatus @default(NOT_FILED)
  arn          String?
  jsonData     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, returnType, returnPeriod])
  @@map("gst_returns")
}

model Gstr2aImport {
  id            String   @id @default(cuid())
  companyId     String
  returnPeriod  String
  supplierGstin String
  invoiceNo     String
  invoiceDate   DateTime
  taxableValue  Decimal
  cgst          Decimal  @default(0)
  sgst          Decimal  @default(0)
  igst          Decimal  @default(0)
  uploadedAt    DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, returnPeriod, supplierGstin, invoiceNo])
  @@index([companyId, returnPeriod])
  @@map("gstr2a_imports")
}

model AuditLog {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  entity    String
  entityId  String
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entity, createdAt])
  @@map("audit_logs")
}

model BillRef {
  id                String    @id @default(cuid())
  companyId         String
  voucherId         String
  ledgerId          String
  billNo            String
  billDate          DateTime
  totalAmount       Decimal
  outstandingAmount Decimal
  drCr              DrCr
  settled           Boolean   @default(false)
  dueDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  ledger            Ledger    @relation(fields: [ledgerId], references: [id])
  voucher           Voucher   @relation(fields: [voucherId], references: [id])
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, settled])
  @@map("bill_refs")
}

model Employee {
  id                     String             @id @default(cuid())
  companyId              String
  name                   String
  employeeCode           String
  designation            String?
  department             String?
  salaryLedgerId         String?
  pfApplicable           Boolean            @default(true)
  esiApplicable          Boolean            @default(false)
  joinDate               DateTime
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  salaryStructureId      String?
  structureEffectiveFrom DateTime?
  attendanceRecords      AttendanceRecord[]
  salaryStructure        SalaryStructure?   @relation(fields: [salaryStructureId], references: [id])
  salaryLedger           Ledger?            @relation("SalaryLedger", fields: [salaryLedgerId], references: [id])
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paySlips               PaySlip[]

  @@unique([companyId, employeeCode])
  @@map("employees")
}

model CostCentre {
  id             String         @id @default(cuid())
  companyId      String
  name           String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucherEntries VoucherEntry[]

  @@unique([companyId, name])
  @@map("cost_centres")
}

model Order {
  id            String      @id @default(cuid())
  companyId     String
  orderType     OrderType
  orderNo       String
  date          DateTime
  partyLedgerId String?
  status        OrderStatus @default(DRAFT)
  totalAmount   Decimal
  narration     String?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  partyLedger   Ledger?     @relation("OrderParty", fields: [partyLedgerId], references: [id])
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, orderType, orderNo])
  @@map("orders")
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  companyId     String
  itemId        String
  godownId      String?
  qty           Decimal
  rate          Decimal
  amount        Decimal
  receivedQty   Decimal   @default(0)
  dispatchedQty Decimal   @default(0)
  godown        Godown?   @relation(fields: [godownId], references: [id])
  item          StockItem @relation(fields: [itemId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model SalaryStructure {
  id         String     @id @default(cuid())
  companyId  String
  name       String
  components Json
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  employees  Employee[]
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("salary_structures")
}

model AttendanceRecord {
  id          String    @id @default(cuid())
  companyId   String
  employeeId  String
  month       String
  presentDays Decimal
  absentDays  Decimal
  halfDays    Int       @default(0)
  leaveDays   Int       @default(0)
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, month])
  @@map("attendance_records")
}

model PayRun {
  id           String    @id @default(cuid())
  companyId    String
  month        String
  status       String    @default("PENDING")
  totalGross   Decimal?
  totalNet     Decimal?
  errorMessage String?
  completedAt  DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paySlips     PaySlip[]

  @@unique([companyId, month])
  @@map("pay_runs")
}

model PaySlip {
  id              String   @id @default(cuid())
  companyId       String
  payRunId        String
  employeeId      String
  month           String
  grossEarnings   Decimal
  totalDeductions Decimal
  netPay          Decimal
  pfEmployee      Decimal
  pfEmployer      Decimal
  esiEmployee     Decimal
  esiEmployer     Decimal
  professionalTax Decimal
  computedData    Json
  pdfKey          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payRun          PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([payRunId, employeeId])
  @@map("pay_slips")
}

model BankStatement {
  id           String            @id @default(cuid())
  companyId    String
  ledgerId     String
  bank         String
  fromDate     DateTime
  toDate       DateTime
  uploadedAt   DateTime          @default(now())
  uploadedBy   String
  rowCount     Int
  ledger       Ledger            @relation(fields: [ledgerId], references: [id])
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([companyId, ledgerId])
  @@map("bank_statements")
}

model BankTransaction {
  id               String        @id @default(cuid())
  companyId        String
  statementId      String
  txDate           DateTime
  description      String
  debitAmount      Decimal?
  creditAmount     Decimal?
  balance          Decimal?
  matchStatus      String        @default("UNMATCHED")
  matchedVoucherId String?
  confidence       String?
  voucher          Voucher?      @relation(fields: [matchedVoucherId], references: [id])
  statement        BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, statementId])
  @@index([companyId, matchStatus])
  @@map("bank_transactions")
}

model EInvoiceLog {
  id           String   @id @default(cuid())
  companyId    String
  voucherId    String
  attempt      Int      @default(1)
  status       String
  errorCode    String?
  errorMsg     String?
  requestJson  Json?
  responseJson Json?
  createdAt    DateTime @default(now())
  voucher      Voucher  @relation(fields: [voucherId], references: [id])
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId])
  @@map("einvoice_logs")
}

model Notification {
  id             String   @id @default(cuid())
  companyId      String
  type           String
  entityId       String?
  sentAt         DateTime @default(now())
  recipientEmail String
  metadata       Json
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type, sentAt])
  @@map("notifications")
}

enum DrCr {
  DR
  CR
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  JOURNAL
  CONTRA
  CREDIT_NOTE
  DEBIT_NOTE
}

enum VoucherStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AccountNature {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

enum GstRegType {
  REGULAR
  COMPOSITION
  UNREGISTERED
  CONSUMER
}

enum SupplyType {
  B2B
  B2C
  B2CS
  B2CL
  EXPORT
  SEZ
}

enum GstrStatus {
  PENDING
  UPLOADED
  FILED
}

enum GstReturnStatus {
  NOT_FILED
  EXPORTED
  UPLOADED
  FILED
}

enum OrderType {
  PURCHASE_ORDER
  SALES_ORDER
}

enum OrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_FULFILLED
  CLOSED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CANCEL
  POST
}

model AppSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
