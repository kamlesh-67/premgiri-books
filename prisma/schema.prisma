// --- NOTIFICATIONS (Phase 11: cron deduplication) ---------------------------
model Notification {
  id             String   @id @default(cuid())
  companyId      String
  type           String   // 'GST_REMINDER' | 'OVERDUE_PAYMENT' | 'PAYROLL_REMINDER'
  entityId       String?  // voucherId, returnPeriod, etc.
  sentAt         DateTime @default(now())
  recipientEmail String
  metadata       Json     @default("{}")

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type, sentAt])
  @@map("notifications")
}
