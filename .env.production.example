# PremGiri Books — Production Environment Variables
# Copy to .env.local (development) or set in Vercel Dashboard (production).
# NEVER commit actual secrets. This file contains only variable names and source hints.

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Source: Neon Dashboard → Your Project → Connection Details → Pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true

# Source: Neon Dashboard → Your Project → Connection Details → Direct connection string
# Required by Prisma for migrations (pgbouncer=true breaks migrations; direct does not)
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Source: Your production app URL (e.g. https://premgiribooks.vercel.app)
NEXTAUTH_URL=https://YOUR_APP.vercel.app

# Source: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# Source: Upstash Console → Your Database → REST API → UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io

# Source: Upstash Console → Your Database → REST API → UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN

# ─── Optional: Playwright E2E (staging only — never set in production) ───────
# Source: A test user account created in the staging Neon DB via pnpm seed
# PLAYWRIGHT_BASE_URL=https://staging.premgiribooks.vercel.app
# PLAYWRIGHT_TEST_EMAIL=e2e-test@premgiribooks.com
# PLAYWRIGHT_TEST_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Phase 11: AI Foundation
VOYAGE_API_KEY=             # https://dash.voyageai.com -> API Keys (Voyage AI voyage-3-lite, 1024-dim, per D-01)
ANTHROPIC_API_KEY=          # https://console.anthropic.com (Claude Haiku 4.5, per D-02 — model id claude-haiku-4-5-20251001)
